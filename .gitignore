# =============================================================================
# Raw market data
#
# Raw WebSocket captures are intentionally excluded from Git.
# They can become large and are generated locally.
# =============================================================================

data/raw/*

# Keep directory structure in Git if .gitkeep is added.
!data/raw/.gitkeep


# =============================================================================
# Processed/generated data
#
# Ignore generated outputs by default, then explicitly retain the compact
# research artifacts required to understand the frozen results.
# =============================================================================

data/processed/*


# -----------------------------------------------------------------------------
# Frozen execution parameters
# -----------------------------------------------------------------------------

!data/processed/execution_parameters.csv


# -----------------------------------------------------------------------------
# Statistical holdout validation
# -----------------------------------------------------------------------------

!data/processed/holdout_validation_session_results.csv
!data/processed/holdout_validation_summary.csv
!data/processed/development_vs_holdout_comparison.csv


# -----------------------------------------------------------------------------
# Development execution summaries
# -----------------------------------------------------------------------------

!data/processed/execution_summary_development.csv
!data/processed/execution_session_latency_development.csv
!data/processed/execution_latency_sensitivity_development.csv
!data/processed/execution_cost_sensitivity_development.csv


# -----------------------------------------------------------------------------
# Holdout execution summaries
# -----------------------------------------------------------------------------

!data/processed/execution_summary_holdout.csv
!data/processed/execution_session_latency_holdout.csv
!data/processed/execution_latency_sensitivity_holdout.csv
!data/processed/execution_cost_sensitivity_holdout.csv
!data/processed/execution_development_vs_holdout.csv


# -----------------------------------------------------------------------------
